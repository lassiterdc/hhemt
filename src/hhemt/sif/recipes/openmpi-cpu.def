# =============================================================================
# hhemt UVA CPU HPC SIF (ADR-19 multi-SIF: the CPU/no-arch bundle carrier).
#
# PURPOSE: the CPU-backend carrier for a cross-hardware container bundle (ADR-19,
# Option A). Kokkos-CPU (OPENMP+SERIAL, no CUDA/ROCm), built WITH host slurm
# (--with-slurm) so CPU sim rows dispatch via `srun --mpi=pmix` on compute nodes,
# exactly like the GPU SIFs. Forked from dev-cpu.def (which omits host slurm because
# it is a dev/local seam-test SIF). Carries NO org.hhemt.gpu_arch / gpu_hardware
# label => its container_build block gets no target_arch => the ingest guard treats
# it as the CPU/no-arch slot and the SIM rung resolves CPU rows to it via sif_path.
#
# Backend flags transcribed from the PROVEN native CPU build
# (_software/triton/build_tritonswmm_cpu/CMakeCache.txt): Kokkos_ENABLE_OPENMP=ON,
# Kokkos_ENABLE_SERIAL=ON, no CUDA. TRITON pin matches uva-cuda.def (15eb18a5).
# =============================================================================

Bootstrap: docker
# ubuntu:24.04 pinned by digest. Digest-ONLY form (repo@sha256) -- apptainer's docker
# conveyor REJECTS a combined tag@digest ref ("references with both a tag and digest
# are currently not supported"). The tag ubuntu:24.04 is retained here in prose.
From: ubuntu@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

%files
    # hhemt source tree -> uv sync --frozen for the in-container process runner.
    # `hhemt_src` is the `git archive` of the identity's hhemt_sha, staged beside this
    # recipe by hhemt.sif.transaction (the build CWD is that staging dir); it carries the
    # git-export-substituted HHEMT_SHA file that %post asserts against {{ HHEMT_SHA }}.
    hhemt_src  /opt/hhemt-src

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    # See uva-cuda.def: rootless --fakeroot with no /etc/subuid runs a single-UID root-mapped
    # namespace; apt's Acquire sandbox drops to uid 42 (_apt), unmapped -> setgroups EPERM, exit
    # 100. Disable the sandbox so apt runs as the mapped root. Harmless when subuid IS present.
    printf 'APT::Sandbox::User "root";\n' > /etc/apt/apt.conf.d/00rootless-nosandbox
    apt-get update
    apt-get install -y --no-install-recommends \
        git cmake build-essential gfortran wget ca-certificates libnuma-dev python3 \
        gcc-14 g++-14 libhwloc-dev libevent-dev
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 100
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-14 100

    # --- (1) OpenMPI 5.0.7 (CPU HPC): same as uva-cuda.def MINUS --with-cuda, but WITH
    #     --with-slurm so CPU rows dispatch via `srun --mpi=pmix` on compute nodes (the
    #     HPC variant of dev-cpu.def, which omits host slurm because it is a dev/local
    #     seam-test SIF). Bundled PMIx 5.0.x; no UCX/OFI (single-node sm/self topology --
    #     add --with-ucx for a multi-node fabric).
    cd /tmp
    OMPI_VER=5.0.7
    wget -q https://download.open-mpi.org/release/open-mpi/v5.0/openmpi-${OMPI_VER}.tar.gz
    echo "67435fdb2560f897882e69fead171d38e7f44a6dfe1d3c90506f549a943050b8  openmpi-${OMPI_VER}.tar.gz" | sha256sum -c -
    tar xf openmpi-${OMPI_VER}.tar.gz && cd openmpi-${OMPI_VER}
    ./configure --prefix=/opt/openmpi \
        --without-ucx --without-ofi --without-hcoll \
        --enable-shared --with-prrte=internal --with-slurm
    make -j"$(nproc)" && make install
    cd /tmp && rm -rf openmpi-* *.tar.gz
    export PATH=/opt/openmpi/bin:${PATH}

    # --- (2) hhemt Python runtime via uv from the committed uv.lock (same as uva).
    wget -qO /tmp/uv-installer.sh https://astral.sh/uv/0.11.7/install.sh
    sh /tmp/uv-installer.sh && rm /tmp/uv-installer.sh
    export PATH=/root/.local/bin:${PATH}
    # Prune any host .venv copied in (parity with uva-cuda.def) so uv builds a clean
    # container-native venv. Belt-and-suspenders: a git-archive build context carries none.
    cd /opt/hhemt-src && rm -rf .venv && uv sync --frozen --no-dev
    # The staged tree is a `git archive` of the identity's hhemt_sha (see %files), which NEVER
    # carries `.git`, so this strip is inert today; it stays as a guard against a `%files ../`
    # regression (a clone's `.git` holds every author e-mail and every committed secret, and
    # `scripts/check_anonymization.py` enumerates a WORKING TREE, never image contents).
    # The in-image toolkit identity is NOT git: it is `/opt/hhemt-src/HHEMT_SHA` (written by
    # git's export-subst at archive time, asserted below in %post) plus the
    # `org.hhemt.hhemt_sha` / `org.hhemt.identity` labels, read at run time by
    # `hhemt.validation.running_identity` (the image rule: labels present -> the file is the
    # sha, the label must agree, a `.git` under the root is refused). Removed AFTER
    # `uv sync` so the install path is unaffected regardless.
    rm -rf /opt/hhemt-src/.git
    # THIRD PRUNE, same reason as the two above: `%files ../` has no ignore mechanism, so image
    # content is a function of the BUILD TREE rather than of this recipe. Measured 2026-09-11: a
    # clean checkout carries 13 MB of test_data and this recipe's sibling records 12 MB in
    # 2026-07-19 -- while a DEPLOYED image built 2026-08-31 measures 16 G of it INSIDE the
    # container, because the Norfolk inputs were sitting in that build tree.
    # THE TWO FIGURES ONLY RECONCILE THROUGH COMPRESSION, and stating that is the point: the SIF
    # itself is 1.74 GB on disk, so 16 G measured inside it is ~9.2x the whole image. A SIF is a
    # squashfs archive and NetCDF/zarr compresses hard, so both numbers are true -- one is the
    # unpacked size, the other the packed file. Do not "correct" either against the other.
    # COST, stated rather than discovered later: an in-container `from_case_study` resolves
    # experiments.py's retrieve_test_data_directory(case_name) at run time and would break. No
    # ensemble uses that path -- their system configs read ${DATA_DIR} under $PACKAGE_DIR, an
    # absolute HOST path reached through the $HOME mount, never anything under /opt/hhemt-src.
    rm -rf /opt/hhemt-src/test_data
    export PATH=/opt/hhemt-src/.venv/bin:/opt/openmpi/bin:${PATH}

    # --- (3) TRITON-SWMM at the SAME pinned commit as uva-cuda.def (15eb18a5), but
    #     Kokkos-CPU: ENABLE_OPENMP + ENABLE_SERIAL, NO CUDA backend / arch. The
    #     dev-test exercises run_mode serial (SERIAL), openmp/hybrid (OPENMP), and
    #     mpi (OpenMPI x SERIAL/OPENMP). Absolute mpic++/mpicc per the uva fix.
    git clone {{ TRITON_URL }} /opt/triton
    cd /opt/triton && git checkout {{ TRITON_SHA }} \
        && git submodule update --init --recursive
    mkdir -p build && cd build
    test -x /opt/openmpi/bin/mpic++ && test -x /opt/openmpi/bin/mpicc || { \
        echo "FATAL: OpenMPI wrappers missing under /opt/openmpi/bin"; ls -la /opt/openmpi/bin; exit 1; }
    cmake -DTRITON_ENABLE_SWMM=ON -DTRITON_SWMM_FLOODING_DEBUG=ON \
          -DTRITON_IGNORE_MACHINE_FILES=ON \
          -DKokkos_ENABLE_OPENMP=ON -DKokkos_ENABLE_SERIAL=ON \
          -DCMAKE_CXX_COMPILER=/opt/openmpi/bin/mpic++ \
          -DCMAKE_C_COMPILER=/opt/openmpi/bin/mpicc \
          -DCMAKE_CXX_FLAGS='-O3' \
          -DCMAKE_SKIP_INSTALL_RPATH=ON -DCMAKE_INSTALL_RPATH= \
          /opt/triton
    make -j"$(nproc)"
    test -x /opt/triton/build/triton.exe   # fail the build if the coupled exe is absent

    # --- (3b) SECOND build: TRITON-ONLY (SWMM coupling COMPILED OUT).
    # The `triton` model type is a DISTINCT BINARY, not a runtime mode: the SWMM
    # init sits behind a compile-time `#ifdef TRITON_SWMM` (triton/src/triton.h:426)
    # and calls read_inp_file(inp_filename) UNCONDITIONALLY, with no empty-string
    # guard (triton/src/swmm_triton.h:139,146-153). A SWMM=ON binary therefore
    # ALWAYS opens inp_filename, while the standalone cfg legitimately omits it, so
    # the coupled exe dies for model_type=triton with `[ERROR] Error reading file: `.
    # Natively this is ALREADY a separate build (build_triton_cpu/, no swmm5 target).
    # Flags identical to the coupled build except the SWMM pair and the build dir.
    mkdir -p /opt/triton/build_triton_only && cd /opt/triton/build_triton_only
    cmake -DTRITON_ENABLE_SWMM=OFF \
          -DTRITON_IGNORE_MACHINE_FILES=ON \
          -DKokkos_ENABLE_OPENMP=ON -DKokkos_ENABLE_SERIAL=ON \
          -DCMAKE_CXX_COMPILER=/opt/openmpi/bin/mpic++ \
          -DCMAKE_C_COMPILER=/opt/openmpi/bin/mpicc \
          -DCMAKE_CXX_FLAGS='-O3' \
          -DCMAKE_SKIP_INSTALL_RPATH=ON -DCMAKE_INSTALL_RPATH= \
          /opt/triton
    make -j"$(nproc)"
    test -x /opt/triton/build_triton_only/triton.exe   # fail if the TRITON-only exe is absent

    # --- (4) Standalone SWMM v5.2.4 (runswmm).
    git clone --branch {{ SWMM_TAG }} --depth 1 \
        https://github.com/USEPA/Stormwater-Management-Model.git /opt/swmm-src
    mkdir -p /opt/swmm-src/build && cd /opt/swmm-src/build
    cmake .. -DCMAKE_BUILD_TYPE=Release && make -j"$(nproc)"

    # --- (5) Install to the convention path the example profile's exe_in_sif uses.
    mkdir -p /opt/hhemt/bin
    cp /opt/triton/build/triton.exe /opt/hhemt/bin/triton.exe
    # The `triton` (TRITON-only) model type needs the SWMM-DISABLED build.
    cp /opt/triton/build_triton_only/triton.exe /opt/hhemt/bin/triton_only.exe
    cp "$(find /opt/swmm-src/build -maxdepth 3 -type f -name runswmm -o -name swmm5 | head -1)" \
        /opt/hhemt/bin/runswmm
    chmod +x /opt/hhemt/bin/triton.exe /opt/hhemt/bin/runswmm

    # ---- MEASURED LABELS: what LANDED, never what was intended ([Q315] 10(ii)) ----
    _measured_triton="$(git -C /opt/triton rev-parse HEAD)"
    [ "$_measured_triton" = "{{ TRITON_SHA }}" ] || { echo "FATAL: TRITON at $_measured_triton, requested {{ TRITON_SHA }}"; exit 1; }
    _landed_hhemt="$(cat /opt/hhemt-src/HHEMT_SHA)"
    case "$_landed_hhemt" in *Format*) echo "FATAL: HHEMT_SHA not substituted: the staged tree was not produced by git archive"; exit 1;; esac
    [ "$_landed_hhemt" = "{{ HHEMT_SHA }}" ] || { echo "FATAL: staged hhemt is $_landed_hhemt, requested {{ HHEMT_SHA }}"; exit 1; }
    _swmm_coupled="$(sed -n 's/.*VERSION \([0-9][0-9.]*\).*/\1/p' /opt/triton/external/swmm/CMakeLists.txt | head -1)"
    _swmm_standalone="$(git -C /opt/swmm-src describe --tags --exact-match HEAD)"
    _mpi="$(/opt/openmpi/bin/ompi_info --version | head -1)"
    _hhemt_version="$(/opt/hhemt-src/.venv/bin/python -c 'from importlib.metadata import version; print(version("hhemt"))')"
    {
      echo "org.hhemt.triton_sha $_measured_triton"
      echo "org.hhemt.hhemt_sha $_landed_hhemt"
      echo "org.hhemt.version $_hhemt_version"
      echo "org.hhemt.swmm_coupled_version $_swmm_coupled"
      echo "org.hhemt.swmm_standalone_version $_swmm_standalone"
      echo "org.hhemt.mpi $_mpi"
    } >> "$APPTAINER_LABELS"

%environment
    export PATH=/opt/hhemt-src/.venv/bin:/opt/hhemt/bin:/opt/openmpi/bin:${PATH}
    export LD_LIBRARY_PATH=/opt/openmpi/lib:${LD_LIBRARY_PATH:-}

%labels
    # STATIC half of the identity (hhemt.sif.identity.SifIdentity.labels(), compared by the
    # read-back gate); the MEASURED half (triton_sha, hhemt_sha, version, swmm_*_version,
    # mpi) is appended by %post above. toolkit_root is read by process_timeseries_runner's
    # container-toolkit guard via /.singularity.d/labels.json and must match the %files dest.
    org.hhemt.identity {{ LBL_IDENTITY }}
    org.hhemt.family {{ LBL_FAMILY }}
    org.hhemt.accel {{ LBL_ACCEL }}
    org.hhemt.gpu_hardware {{ LBL_GPU_HARDWARE }}
    org.hhemt.gpu_arch {{ LBL_GPU_ARCH }}
    org.hhemt.gpu_compilation_backend {{ LBL_GPU_BACKEND }}
    org.hhemt.triton_url {{ TRITON_URL }}
    org.hhemt.base_digest {{ BASE_REF }}
    org.hhemt.recipe_sha256 {{ LBL_RECIPE_SHA256 }}
    org.hhemt.toolkit_root /opt/hhemt-src
    org.hhemt.openmpi     5.0.7-pmix5
    org.hhemt.gcc         14.2.0

%runscript
    exec "$@"
